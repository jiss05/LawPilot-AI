# Application Configuration
APP_NAME=LawPilot-AI
APP_ENV=development

# Backend Configuration
BACKEND_HOST=localhost
BACKEND_PORT=8000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Database Configuration
DATABASE_URL=postgresql+psycopg://legal_ai_user:local_dev_password@localhost:5432/legal_ai

# Vector Database Configuration
QDRANT_URL=http://localhost:6333

# LLM Configuration (SCRUM-19/20). See backend/app/llm/README.md.
LLM_PROVIDER=ollama
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_FALLBACK_MODEL=
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_RECORD_RUNS=true

# Document ingestion, embeddings and retrieval (Sprint 2). All optional;
# defaults shown. See backend/app/ingestion/README.md for every setting.
QDRANT_API_KEY=
INGESTION_QDRANT_COLLECTION=legal_chunks_v1
INGESTION_EMBEDDING_PROVIDER=sentence-transformers
INGESTION_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
INGESTION_OCR_ENABLED=true
INGESTION_OCR_LANGUAGES=["en"]
INGESTION_CHUNK_MAX_TOKENS=400
INGESTION_CHUNK_OVERLAP_TOKENS=50
# INGESTION_STORAGE_DIR=        (default: backend/legal_documents)
# INGESTION_EXTRACTED_DIR=      (default: backend/storage/extracted)
